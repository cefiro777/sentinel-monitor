# Скопируйте в .env и заполните (или запустите deploy/install.sh — он создаст .env сам).

# Версия образа сервера из ghcr.io (latest или номер, например 0.4.0)
SENTINEL_VERSION=latest

# Домен (monitor.example.com) — тогда Caddy сам получит сертификат Let's Encrypt (нужны A-запись и открытые 80/443).
# Либо IP-адрес VPS (например 203.0.113.10) — тогда раскомментируйте CADDYFILE=Caddyfile.ip.
SENTINEL_DOMAIN=monitor.example.com
#CADDYFILE=Caddyfile.ip
# Если на сервере уже есть nginx на 80/443 — используйте docker-compose.nginx.yml; порт для проксирования:
#SENTINEL_PORT=8085

POSTGRES_PASSWORD=change-me-long-random
ADMIN_EMAIL=admin@example.com
# Пусто — пароль будет сгенерирован и выведен в лог сервера при первом запуске (docker compose logs server)
ADMIN_PASSWORD=

# SOCKS5/HTTP-прокси для Telegram Bot API, если api.telegram.org недоступен напрямую (пусто — без прокси).
# Формат: socks5://user:pass@host:1080 или http://host:3128
TELEGRAM_PROXY=
