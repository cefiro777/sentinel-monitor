<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!--
      Длинные пути (> 260 символов). .NET Framework по умолчанию обрезает пути по MAX_PATH;
      с этими переключателями работают пути с префиксом \\?\ и длинные пути на системах с LongPathsEnabled.
      Без них бэкап файловых шар с глубокой вложенностью валится на части файлов.
    -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
