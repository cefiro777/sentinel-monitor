{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sentinel;Username=sentinel;Password=sentinel"
  },
  "Sentinel": {
    "DataDir": "data",
    "PublicUrl": "http://localhost:5080",
    "CertificatePin": null,
    "AgentOfflineAfterSeconds": 120,
    "CommandTtlSeconds": 300,
    "Jwt": {
      "Issuer": "sentinel",
      "Audience": "sentinel-web",
      "AccessTokenMinutes": 480
    },
    "Bootstrap": {
      "AdminEmail": "admin@local",
      "AdminPassword": null
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
